# Removing the NAs (anything that wasn't IDed to genus gets deleted here)
NC_Shark_prey_genus_merge.ps<-tax_glom(NC_Sharks.ps, taxrank = "genus", NArm = TRUE)
# play with ordinations interactively
pseq_fecal <- NC_Shark_prey_genus_merge.ps %>%
phyloseq_validate()
# MDS Plot (genus) - bray
pseq_fecal %>%
tax_transform(rank = "genus", trans = "compositional") %>%
dist_calc(dist = "bray") %>%
ord_calc(method = "PCoA") %>%
ord_plot(
axes = c(1, 2),
colour = "Species..scientific.name.",
fill = "Species..scientific.name.",
shape = "circle",
alpha = 0.5,
size = 2
) +
ggplot2::stat_ellipse(
ggplot2::aes(colour = Species..scientific.name.)
) +
theme(
panel.grid = element_blank(),
panel.grid.major = element_blank())
# Statistics for MDS plot (prey at genus level) - bray
bray_dist_matrix <- phyloseq::distance(pseq_fecal, method ="bray")
set.seed(200)
permanova <- vegan::adonis2(bray_dist_matrix ~ phyloseq::sample_data(pseq_fecal)$Species..scientific.name.)
# 1. Calculate multivariate dispersion (PERMDISP)
# 'bray_dist_matrix' is your existing distance object
# 'Species..scientific.name.' is your shark species column
groups <- phyloseq::sample_data(pseq_fecal)$Species..scientific.name.
dispersion <- betadisper(bray_dist_matrix, groups)
# 2. Test for significance
# This tells you if the "spread" is significantly different between species
disp_test <- permutest(dispersion, pairwise = TRUE, permutations = 999)
print(disp_test)
# This will show you the average distance to centroid for each species
dispersion$group.distances
# Basic plot to see the hulls and centroids
plot(dispersion, hull = FALSE, ellipse = TRUE,
main = "Multivariate Dispersion (Bray-Curtis)",
xlab = "PCoA 1", ylab = "PCoA 2")
# Boxplot of distances to centroid (easier way to see variance)
boxplot(dispersion, main = "Distance to Centroid by Shark Species",
las = 2, cex.axis = 0.7, col = "lightblue")
# Basic plot to see the hulls and centroids
plot(dispersion, hull = FALSE, ellipse = TRUE,
main = "Multivariate Dispersion (Bray-Curtis)",
xlab = "PCoA 1", ylab = "PCoA 2")
